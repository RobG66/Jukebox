<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jukebox.ViewModels"
             xmlns:models="using:Jukebox.Models"
             mc:Ignorable="d"
             d:DesignWidth="260"
             d:DesignHeight="620"
             x:Class="Jukebox.Views.PlayQueueView"
             x:DataType="vm:JukeboxViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Delete"
                    Command="{Binding PlaylistViewModel.RemovePlayQueueSelectedCommand}"
                    CommandParameter="{Binding #PlayQueueDataGrid.SelectedItems}"/>
        <KeyBinding Gesture="Ctrl+Shift+L"
                    Command="{Binding PlaylistViewModel.ClearPlayQueueCommand}"/>
        <KeyBinding Gesture="Ctrl+S"
                    Command="{Binding PlaylistViewModel.SavePlayQueueAsPlaylistCommand}"/>
        <KeyBinding Gesture="F2"
                    Command="{Binding PlaylistViewModel.RenamePlayQueueSelectedCommand}"
                    CommandParameter="{Binding #PlayQueueDataGrid.SelectedItems}"/>
        <KeyBinding Gesture="Enter"
                    Command="{Binding PlayTrackCommand}"
                    CommandParameter="{Binding #PlayQueueDataGrid.SelectedItem}"/>
    </UserControl.KeyBindings>

    <Design.DataContext>
        <vm:JukeboxViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="DataGrid.media-grid DataGridRow">
            <Setter Property="Height" Value="NaN"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="0" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,2,2,4">
            <StackPanel Spacing="2">
                <TextBlock Classes="media-eyebrow" Text="PLAYBACK ORDER"/>
                <TextBlock Classes="media-page-title" Text="Queue"/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Classes="media-muted"
                       Text="{Binding PlaylistViewModel.PlayQueue.Count, StringFormat='{}{0} tracks'}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1"
                Classes="media-card"
                Margin="0,0,0,8"
                Padding="10,8"
                IsVisible="{Binding CanStop}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Image Grid.Column="0"
                       Source="avares://Jukebox/Assets/Icons/nowplaying.png"
                       Width="17" Height="17"
                       VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Classes="media-eyebrow" Text="NOW PLAYING"/>
                    <TextBlock Text="{Binding CurrentTrack.DisplayName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding CurrentTrack.DisplayName}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="4"
              Margin="0,0,0,8">
            <Button Grid.Column="0"
                    Classes="media-primarybutton"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding PlaylistViewModel.HasPlayQueueItems}"
                    ToolTip.Tip="Save Queue As Playlist (Ctrl+S)"
                    Command="{Binding PlaylistViewModel.SavePlayQueueAsPlaylistCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Image Source="avares://Jukebox/Assets/Icons/save.png"
                           Width="16" Height="16"/>
                    <TextBlock Text="Save queue" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RemoveQueueSelectionButton"
                    Grid.Column="1"
                    Classes="media-iconbutton"
                    IsEnabled="False"
                    ToolTip.Tip="Remove Selected (Delete)"
                    Command="{Binding PlaylistViewModel.RemovePlayQueueSelectedCommand}"
                    CommandParameter="{Binding #PlayQueueDataGrid.SelectedItems}">
                <Image Source="avares://Jukebox/Assets/Icons/minus.png"
                       Width="17" Height="17"
                       Stretch="Uniform"/>
            </Button>
            <Button Grid.Column="2"
                    Classes="media-iconbutton danger"
                    IsEnabled="{Binding PlaylistViewModel.HasPlayQueueItems}"
                    ToolTip.Tip="Clear Play Queue (Ctrl+Shift+L)"
                    Command="{Binding PlaylistViewModel.ClearPlayQueueCommand}">
                <Image Source="avares://Jukebox/Assets/Icons/clean.png"
                       Width="17" Height="17"
                       Stretch="Uniform"/>
            </Button>
        </Grid>

        <Border Grid.Row="3" Classes="media-card" MinHeight="0">
        <Grid>
        <DataGrid x:Name="PlayQueueDataGrid"
                  Classes="media-grid"
                  ItemsSource="{Binding PlaylistViewModel.PlayQueueView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MinHeight="0"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal"
                  DoubleTapped="PlayQueueDataGrid_DoubleTapped"
                  SelectionChanged="PlayQueueDataGrid_SelectionChanged">
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="PlayQueueContextMenu"
                             Opened="PlayQueueContextMenu_Opened">
                    <MenuItem x:Name="PlayQueuePlayNowMenuItem"
                              Header="Play now"
                              Click="PlayQueuePlayNow_Click"/>
                    <MenuItem x:Name="PlayQueueRenameMenuItem"
                              Header="Rename track"
                              InputGesture="F2"
                              Click="PlayQueueRename_Click"/>
                    <Separator/>
                    <MenuItem x:Name="PlayQueueRemoveMenuItem"
                              Header="Remove from queue"
                              InputGesture="Delete"
                              Click="PlayQueueRemove_Click"/>
                    <MenuItem Header="Save queue as playlist"
                              InputGesture="Ctrl+S"
                              Click="PlayQueueSave_Click"/>
                    <MenuItem Header="Clear queue"
                              InputGesture="Ctrl+Shift+L"
                              Click="PlayQueueClear_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Title"
                                        x:DataType="models:JukeboxTrack"
                                        Width="7*"
                                        CellTemplate="{StaticResource TrackTitleCellTemplate}"/>
            </DataGrid.Columns>
        </DataGrid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="20"
                        IsHitTestVisible="False"
                        IsVisible="{Binding !PlaylistViewModel.HasPlayQueueItems}">
                <Image
                       Source="avares://Jukebox/Assets/Icons/music.png"
                       Width="28" Height="28"/>
                <TextBlock Text="Your queue is empty"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Classes="media-muted"
                           Text="Drop files here or add music from a browser."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="230"/>
            </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="4"
                Classes="media-card"
                Margin="0,8,0,0"
                Padding="10,7">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding PlaylistViewModel.PlayQueueSummary}"
                           Foreground="{DynamicResource MediaPanelMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="8,0,0,0">
                    <Button x:Name="RenameQueueSelectionButton"
                            Classes="media-iconbutton"
                            Width="30" Height="30"
                            IsEnabled="False"
                            ToolTip.Tip="Rename selected track (F2)"
                            Click="RenamePlayQueueSelected_Click">
                        <Image Source="avares://Jukebox/Assets/Icons/edit.png"
                               Width="17" Height="17"
                               Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MoveQueueSelectionUpButton"
                            Classes="media-iconbutton"
                            Width="30" Height="30"
                            IsEnabled="False"
                            ToolTip.Tip="Move selected track(s) up"
                            Click="MovePlayQueueSelectedUp_Click">
                        <Image Source="avares://Jukebox/Assets/Icons/uparrow.png"
                               Width="17" Height="17"
                               Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MoveQueueSelectionDownButton"
                            Classes="media-iconbutton"
                            Width="30" Height="30"
                            IsEnabled="False"
                            ToolTip.Tip="Move selected track(s) down"
                            Click="MovePlayQueueSelectedDown_Click">
                        <Image Source="avares://Jukebox/Assets/Icons/downarrow.png"
                               Width="17" Height="17"
                               Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
